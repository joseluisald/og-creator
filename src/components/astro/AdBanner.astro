---
import { ExternalLink, X } from 'lucide-astro';

interface Props {
  format?: 'leaderboard' | 'sidebar' | 'native';
  className?: string;
  slotId?: string;
}

const { format = 'leaderboard', className = '', slotId = 'default-ad-slot' } = Astro.props;

const SPONSORS = [
  {
    title: 'Deploy em Segundos na Nuvem',
    description: 'Hospede suas aplicações full-stack, bancos Postgres e APIs sem dor de cabeça com escala automática.',
    cta: 'Começar Grátis',
    url: 'https://vercel.com',
    sponsorName: 'Cloud Deploy Pro',
    tag: 'Infraestrutura',
    icon: '⚡',
    badgeColor: 'border-cyan-500/30 bg-cyan-950/30 text-cyan-300'
  },
  {
    title: 'Postgres & Autenticação para Devs',
    description: 'Bancos de dados relacionais em tempo real, Auth e Storage prontos para o seu próximo projeto.',
    cta: 'Criar Projeto Grátis',
    url: 'https://supabase.com',
    sponsorName: 'Database Cloud',
    tag: 'Backend & SQL',
    icon: '🗄️',
    badgeColor: 'border-emerald-500/30 bg-emerald-950/30 text-emerald-300'
  },
  {
    title: 'Monitoramento de Erros & Performance',
    description: 'Identifique bugs antes dos seus usuários. Rastreie exceptions em Next.js, Node, React e mobile.',
    cta: 'Testar sem Cartão',
    url: 'https://sentry.io',
    sponsorName: 'ErrorTracker AI',
    tag: 'Observabilidade',
    icon: '🛡️',
    badgeColor: 'border-purple-500/30 bg-purple-950/30 text-purple-300'
  },
  {
    title: 'Envio Transacional de E-mails para APIs',
    description: 'Entregabilidade de 99.9% com SDKs em TypeScript e templates limpos em React Email.',
    cta: '10k Envios Grátis',
    url: 'https://resend.com',
    sponsorName: 'Email Delivery',
    tag: 'Email API',
    icon: '✉️',
    badgeColor: 'border-amber-500/30 bg-amber-950/30 text-amber-300'
  }
];

const sponsorIndex = Math.abs(slotId.split('').reduce((acc, c) => acc + c.charCodeAt(0), 0)) % SPONSORS.length;
const currentSponsor = SPONSORS[sponsorIndex];
---

{format === 'leaderboard' && (
  <div class={`w-full max-w-5xl mx-auto my-3 px-3 sm:px-4 ${className}`}>
    <div class="relative bg-gradient-to-r from-[#14161d] via-[#1a1d24] to-[#14161d] border border-[#ffffff15] rounded-xl p-3 sm:py-2.5 sm:px-4 flex flex-col sm:flex-row items-center justify-between gap-3 shadow-md">
      <div class="flex items-center gap-3 w-full sm:w-auto">
        <div class="w-9 h-9 rounded-lg bg-[#0a0a0a] border border-[#ffffff15] flex items-center justify-center text-lg shrink-0">
          {currentSponsor.icon}
        </div>
        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <span class="text-[9px] uppercase tracking-wider font-mono px-1.5 py-0.5 rounded bg-white/5 text-[#71717a] border border-white/5">
              Publicidade
            </span>
            <span class={`text-[10px] font-semibold px-2 py-0.5 rounded-full border ${currentSponsor.badgeColor}`}>
              {currentSponsor.tag}
            </span>
            <span class="text-[11px] font-bold text-white truncate">
              {currentSponsor.sponsorName}
            </span>
          </div>
          <p class="text-xs text-[#a1a1aa] mt-0.5 line-clamp-1">
            {currentSponsor.title} – {currentSponsor.description}
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2 shrink-0 w-full sm:w-auto justify-end">
        <a
          href={currentSponsor.url}
          target="_blank"
          rel="noopener noreferrer sponsored"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#d4af37] hover:bg-[#f9e79f] text-black font-semibold text-xs transition cursor-pointer shadow-sm shadow-[#d4af3720] text-decoration-none"
        >
          <span>{currentSponsor.cta}</span>
          <ExternalLink class="w-3 h-3" />
        </a>
      </div>
    </div>
  </div>
)}

{format === 'native' && (
  <div class={`bg-gradient-to-br from-[#121418] to-[#181b22] border border-[#d4af37]/30 rounded-xl p-5 relative ${className}`}>
    <div class="flex items-center justify-between mb-3">
      <div class="flex items-center gap-2">
        <span class="text-base">{currentSponsor.icon}</span>
        <span class="text-xs font-bold text-white">{currentSponsor.sponsorName}</span>
      </div>
      <span class="text-[9px] font-mono uppercase px-1.5 py-0.5 rounded bg-white/5 text-[#71717a]">
        Patrocinado
      </span>
    </div>

    <h4 class="text-sm font-semibold text-[#f9e79f] mb-1.5">
      {currentSponsor.title}
    </h4>
    <p class="text-xs text-[#a1a1aa] leading-relaxed mb-4">
      {currentSponsor.description}
    </p>

    <a
      href={currentSponsor.url}
      target="_blank"
      rel="noopener noreferrer sponsored"
      class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-[#d4af37] hover:bg-[#f9e79f] text-black text-xs font-bold transition text-decoration-none"
    >
      <span>{currentSponsor.cta}</span>
      <ExternalLink class="w-3 h-3" />
    </a>
  </div>
)}

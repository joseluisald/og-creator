---
import {
  Sparkles,
  ChevronDown,
  Menu,
  X,
  Search,
  Smile,
  ShieldCheck,
  ArrowRightLeft,
  Image as ImageIcon,
  Code2,
  ShieldAlert,
  Bot,
  HelpCircle,
  Info,
  ArrowRight,
  LayoutGrid
} from 'lucide-astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const APPS_LIST = [
  {
    href: '/serp-simulator',
    title: 'Simulador SERP Google',
    desc: 'Pré-visualização Desktop & Mobile com corte em 580px',
    icon: Search,
    badge: '580px',
    badgeColor: 'bg-amber-500/15 text-amber-300 border-amber-500/30',
    iconColor: 'text-amber-400',
    iconBg: 'bg-amber-500/10 border-amber-500/20'
  },
  {
    href: '/favicon-studio',
    title: 'Favicon & PWA Studio',
    desc: 'Gere .ico, Apple Touch Icon e Web Manifest',
    icon: Smile,
    badge: 'PWA',
    badgeColor: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30',
    iconColor: 'text-emerald-400',
    iconBg: 'bg-emerald-500/10 border-emerald-500/20'
  },
  {
    href: '/security-headers',
    title: 'Headers HTTP de Segurança',
    desc: 'Configuração CSP, HSTS, X-Frame para Nginx e Apache',
    icon: ShieldCheck,
    badge: 'CSP/HSTS',
    badgeColor: 'bg-indigo-500/15 text-indigo-300 border-indigo-500/30',
    iconColor: 'text-indigo-400',
    iconBg: 'bg-indigo-500/10 border-indigo-500/20'
  },
  {
    href: '/redirects-generator',
    title: 'Gerador de Redirecionamentos',
    desc: 'Regras 301/302 para .htaccess, Nginx, Netlify e Vercel',
    icon: ArrowRightLeft,
    badge: '301/302',
    badgeColor: 'bg-cyan-500/15 text-cyan-300 border-cyan-500/30',
    iconColor: 'text-cyan-400',
    iconBg: 'bg-cyan-500/10 border-cyan-500/20'
  },
  {
    href: '/og-studio',
    title: 'OG Image Studio',
    desc: 'Criação de imagens 1200×630 para WhatsApp e redes',
    icon: ImageIcon,
    badge: '1200×630',
    badgeColor: 'bg-yellow-500/15 text-yellow-300 border-yellow-500/30',
    iconColor: 'text-yellow-400',
    iconBg: 'bg-yellow-500/10 border-yellow-500/20'
  },
  {
    href: '/meta-tags',
    title: 'Meta Tags & Schema JSON-LD',
    desc: 'Gerador de SEO e Schema estruturado para 9 frameworks',
    icon: Code2,
    badge: 'Schema',
    badgeColor: 'bg-blue-500/15 text-blue-300 border-blue-500/30',
    iconColor: 'text-blue-400',
    iconBg: 'bg-blue-500/10 border-blue-500/20'
  },
  {
    href: '/robots-sitemap',
    title: 'Robots.txt & Sitemap Shield',
    desc: 'Bloqueio de bots de IA e proteção de indexação',
    icon: ShieldAlert,
    badge: 'Shield',
    badgeColor: 'bg-rose-500/15 text-rose-300 border-rose-500/30',
    iconColor: 'text-rose-400',
    iconBg: 'bg-rose-500/10 border-rose-500/20'
  },
  {
    href: '/llms-txt',
    title: 'llms.txt Studio para IA',
    desc: 'Padronização de documentação para Cursor e Claude',
    icon: Bot,
    badge: 'LLMs',
    badgeColor: 'bg-purple-500/15 text-purple-300 border-purple-500/30',
    iconColor: 'text-purple-400',
    iconBg: 'bg-purple-500/10 border-purple-500/20'
  },
];
---

<header class="w-full bg-[#0a0a0d]/95 border-b border-[#ffffff15] sticky top-0 z-50 backdrop-blur-xl shadow-lg shadow-black/40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between gap-4">
    {/* Brand */}
    <a
      href="/"
      class="flex items-center gap-2.5 shrink-0 group text-decoration-none focus:outline-none"
      title="Web & SEO Studio - Início"
    >
      <div class="relative w-8 h-8 rounded-xl bg-gradient-to-br from-[#d4af37] via-[#f9e79f] to-[#b38f28] flex items-center justify-center shadow-md shadow-[#d4af3730] group-hover:scale-105 transition-all">
        <Sparkles class="w-4 h-4 text-black drop-shadow-sm" />
        <span class="absolute -bottom-1 -right-1 w-2.5 h-2.5 rounded-full bg-emerald-500 border-2 border-[#0a0a0d]" title="Online e Pronto" />
      </div>
      <div class="flex flex-col">
        <span class="font-extrabold text-base sm:text-lg text-white tracking-tight leading-tight group-hover:text-[#f9e79f] transition-colors">
          Web &amp; SEO <span class="text-[#d4af37]">Studio</span>
        </span>
        <span class="text-[10px] text-[#71717a] font-mono tracking-wider">
          SUÍTE GRATUITA PARA WEB
        </span>
      </div>
    </a>

    {/* Clean Center Navigation Menus */}
    <nav class="hidden md:flex items-center gap-1.5 relative">
      {/* Apps Dropdown Trigger (Group with Hover Popover) */}
      <div class="relative group" id="astro-apps-dropdown">
        <button
          type="button"
          id="astro-apps-trigger"
          class={`inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold transition-all cursor-pointer ${
            currentPath !== '/'
              ? 'bg-[#1a1d26] text-[#f9e79f] border border-[#d4af37]/40 shadow-sm'
              : 'text-[#a1a1aa] hover:text-white hover:bg-[#14161f]'
          }`}
        >
          <LayoutGrid class="w-3.5 h-3.5 text-[#d4af37]" />
          <span>Ferramentas (8)</span>
          <ChevronDown class="w-3.5 h-3.5 text-[#71717a] group-hover:rotate-180 group-hover:text-[#d4af37] transition-transform duration-200" />
        </button>

        {/* Apps Dropdown Menu Popup (Hover on desktop) */}
        <div class="absolute top-full left-0 mt-2 w-[520px] bg-[#101217] border border-[#ffffff15] rounded-2xl p-3 shadow-2xl shadow-black/80 z-50 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 transform group-hover:translate-y-0 translate-y-1">
          <div class="flex items-center justify-between px-2.5 py-1.5 mb-2 border-b border-[#ffffff10]">
            <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[#d4af37]">
              Todas as 8 Ferramentas
            </span>
            <a
              href="/#ferramentas"
              class="text-[11px] text-[#a1a1aa] hover:text-white transition text-decoration-none flex items-center gap-1"
            >
              <span>Ver no Grid</span>
              <ArrowRight class="w-3 h-3" />
            </a>
          </div>

          <div class="grid grid-cols-2 gap-1.5">
            {APPS_LIST.map((app) => {
              const IconComponent = app.icon;
              const isActive = currentPath === app.href || (app.href !== '/' && currentPath.startsWith(app.href));
              return (
                <a
                  href={app.href}
                  class={`flex items-start gap-2.5 p-2.5 rounded-xl transition text-left text-decoration-none group/item ${
                    isActive
                      ? 'bg-[#1e2230] border border-[#d4af37]/40'
                      : 'hover:bg-[#181a22] border border-transparent'
                  }`}
                >
                  <div
                    class={`w-8 h-8 rounded-lg ${app.iconBg} border flex items-center justify-center shrink-0 ${app.iconColor} group-hover/item:scale-105 transition-transform`}
                  >
                    <IconComponent class="w-4 h-4" />
                  </div>
                  <div class="flex flex-col min-w-0 flex-1">
                    <div class="flex items-center justify-between gap-1 mb-0.5">
                      <span
                        class={`text-xs font-bold truncate ${
                          isActive ? 'text-[#f9e79f]' : 'text-white group-hover/item:text-[#f9e79f]'
                        }`}
                      >
                        {app.title}
                      </span>
                      <span
                        class={`text-[9px] font-mono font-bold px-1.5 py-0.5 rounded border shrink-0 ${app.badgeColor}`}
                      >
                        {app.badge}
                      </span>
                    </div>
                    <span class="text-[10px] text-[#71717a] group-hover/item:text-[#a1a1aa] line-clamp-1 leading-tight">
                      {app.desc}
                    </span>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </div>

      {/* About / Sobre */}
      <a
        href="/#sobre"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-medium text-[#a1a1aa] hover:text-white hover:bg-[#14161f] transition text-decoration-none"
      >
        <Info class="w-3.5 h-3.5 text-[#a1a1aa]" />
        <span>Sobre</span>
      </a>

      {/* FAQ */}
      <a
        href="/#faq"
        class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-medium text-[#a1a1aa] hover:text-white hover:bg-[#14161f] transition text-decoration-none"
      >
        <HelpCircle class="w-3.5 h-3.5 text-[#a1a1aa]" />
        <span>FAQ</span>
      </a>
    </nav>

    {/* Right Action CTA Button (Desktop) */}
    <div class="hidden md:flex items-center gap-2.5">
      <a
        href="/#ferramentas"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-[#d4af37] to-[#e6be44] hover:from-[#e6be44] hover:to-[#d4af37] text-black font-bold text-xs transition text-decoration-none shadow-md shadow-[#d4af3720] hover:scale-[1.02]"
      >
        <Sparkles class="w-3.5 h-3.5 text-black" />
        <span>Explorar Ferramentas</span>
      </a>
    </div>

    {/* Mobile Hamburger Button */}
    <div class="md:hidden flex items-center">
      <button
        type="button"
        id="astro-mobile-toggle"
        class="p-2 rounded-xl bg-[#14161f] border border-[#ffffff15] text-[#a1a1aa] hover:text-white transition cursor-pointer"
        aria-label="Abrir Menu"
      >
        <Menu class="w-5 h-5" />
      </button>
    </div>
  </div>

  {/* Mobile Drawer Menu */}
  <div id="astro-mobile-menu" class="hidden md:hidden border-t border-[#ffffff10] bg-[#0c0d12] px-4 py-4 space-y-4">
    <div class="flex flex-col gap-1.5">
      <span class="text-[10px] font-mono uppercase tracking-wider text-[#d4af37] px-2 font-bold">
        Navegação
      </span>
      <a
        href="/"
        class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold text-white hover:bg-[#161822] text-decoration-none"
      >
        <Sparkles class="w-3.5 h-3.5 text-[#d4af37]" />
        <span>Página Inicial</span>
      </a>
      <a
        href="/#sobre"
        class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold text-white hover:bg-[#161822] text-decoration-none"
      >
        <Info class="w-3.5 h-3.5 text-[#a1a1aa]" />
        <span>Sobre o Studio</span>
      </a>
      <a
        href="/#faq"
        class="flex items-center gap-2 px-3 py-2 rounded-xl text-xs font-semibold text-white hover:bg-[#161822] text-decoration-none"
      >
        <HelpCircle class="w-3.5 h-3.5 text-[#a1a1aa]" />
        <span>Perguntas Frequentes (FAQ)</span>
      </a>
    </div>

    <div class="pt-2 border-t border-[#ffffff10] flex flex-col gap-1.5">
      <span class="text-[10px] font-mono uppercase tracking-wider text-[#d4af37] px-2 font-bold">
        Ferramentas Disponíveis
      </span>
      <div class="grid grid-cols-1 gap-1">
        {APPS_LIST.map((app) => {
          const IconComponent = app.icon;
          const isActive = currentPath === app.href;
          return (
            <a
              href={app.href}
              class={`flex items-center justify-between px-3 py-2 rounded-xl text-xs font-medium text-decoration-none transition ${
                isActive
                  ? 'bg-[#1e2230] text-[#f9e79f] font-bold border border-[#d4af37]/40'
                  : 'text-[#a1a1aa] hover:text-white hover:bg-[#141620]'
              }`}
            >
              <div class="flex items-center gap-2">
                <IconComponent class={`w-3.5 h-3.5 ${app.iconColor}`} />
                <span>{app.title}</span>
              </div>
              <span class={`text-[9px] font-mono px-1.5 py-0.5 rounded ${app.badgeColor}`}>
                {app.badge}
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</header>

<script>
  const mobileToggle = document.getElementById('astro-mobile-toggle');
  const mobileMenu = document.getElementById('astro-mobile-menu');

  if (mobileToggle && mobileMenu) {
    mobileToggle.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
